
:root {
  color-scheme: dark;
  --bg: #171a2e;
  --panel: #20243d;
  --panel-light: #292e4b;
  --line: #343a5c;
  --text: #f6f6ff;
  --muted: #a4abc8;
  --purple: #7757ff;
  --blue: #566fff;
  --pink: #e94fb5;
  --green: #44e5a1;
}

* { box-sizing: border-box; }

html {
  background: #101220;
  scroll-behavior: smooth;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  color: var(--text);
  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 15px;
  min-height: 100vh;
}

button, input, select { font: inherit; }
button { color: inherit; cursor: pointer; }
button:active { transform: scale(.98); }
button:disabled { cursor: not-allowed; opacity: .55; }
.app {
  width: 100%;
  max-width: 900px;
  min-height: 100vh;
  margin: auto;
  padding: 0 16px calc(100px + env(safe-area-inset-bottom));
  overflow: hidden;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: calc(18px + env(safe-area-inset-top)) 0 22px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--text);
  font-size: 19px;
  font-weight: 900;
  letter-spacing: -.6px;
  text-decoration: none;
}
.brand-icon {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: 13px;
  background: linear-gradient(145deg, #9b7aff, #5435e8);
  box-shadow: 0 4px 20px #7757ff55;
  font-size: 25px;
  font-weight: 1000;
  font-style: italic;
}
.brand-accent { color: #9b85ff; }
.brand small {
  display: block;
  margin-top: 3px;
  color: var(--muted);
  font-size: 8px;
  letter-spacing: 1.5px;
}
.wallet {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 9px 11px;
  border: 1px solid #44496d;
  border-radius: 15px;
  background: #222640;
  font-weight: 850;
  white-space: nowrap;
}
.coin {
  display: grid;
  place-items: center;
  width: 25px;
  height: 25px;
  border-radius: 50%;
  background: linear-gradient(140deg, #7fcaff, #4865ff);
  color: white;
  font-weight: 1000;
}
.currency { color: #aaa4ff; font-size: 10px; }

.page { display: none; animation: appear .24s ease; }
.page.active { display: block; }
@keyframes appear {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

.hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  min-height: 245px;
  padding: 23px 21px;
  border: 1px solid #514b9c;
  border-radius: 25px;
  background:
    radial-gradient(ellipse at 85% 20%, #6952f5aa, transparent 43%),
    radial-gradient(ellipse at 5% 100%, #b535b666, transparent 45%),
    linear-gradient(130deg, #171148, #292a80 55%, #392e91);
  box-shadow: inset 0 0 45px #806aff16;
}
.hero-glow {
  position: absolute;
  z-index: -1;
  width: 170px;
  height: 170px;
  right: -20px;
  top: 45px;
  border-radius: 50%;
  background: #7b62ff44;
  filter: blur(32px);
}
.eyebrow {
  color: #aaa1ff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.7px;
}
.live-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-right: 5px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 9px #44e5a1;
}
.hero h1 {
  position: relative;
  z-index: 1;
  margin: 20px 0 10px;
  font-size: clamp(27px, 7vw, 43px);
  line-height: 1.05;
  font-weight: 1000;
  letter-spacing: -1.6px;
}
.hero h1 span {
  color: #a99aff;
  text-shadow: 0 0 20px #8d70ff55;
}
.hero p {
  position: relative;
  z-index: 1;
  max-width: 75%;
  color: #d0d0f2;
  font-size: 12px;
  line-height: 1.6;
}
.hero .primary-btn { position: relative; z-index: 2; }
.hero-orb {
  position: absolute;
  display: grid;
  place-items: center;
  border: 1px solid #ffffff2a;
  border-radius: 23px;
  background: linear-gradient(145deg, #ffffff20, #ffffff05);
  box-shadow: 0 10px 30px #09092355;
}
.orb-one {
  top: 35px;
  right: 24px;
  width: 58px;
  height: 58px;
  color: #ffe78a;
  font-size: 37px;
  transform: rotate(12deg);
}
.orb-two {
  right: 28px;
  bottom: 23px;
  width: 73px;
  height: 73px;
  color: #d9d0ff;
  font-size: 44px;
  font-weight: 1000;
  font-style: italic;
  transform: rotate(-10deg);
}

.primary-btn, .secondary-btn, .small-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid #9a8cff;
  border-radius: 15px;
  background: linear-gradient(105deg, #5c79ff, #8050f5);
  color: white;
  font-weight: 850;
  box-shadow: 0 5px 18px #6757ff25;
  transition: filter .15s, transform .15s;
}
.primary-btn { min-height: 44px; padding: 0 17px; }
.primary-btn:hover, .small-btn:hover { filter: brightness(1.12); }
.secondary-btn {
  border-color: #41496f;
  background: #292e4b;
  box-shadow: none;
}
.full-btn { width: 100%; min-height: 49px; margin-top: 14px; }
.small-btn { min-height: 37px; padding: 0 13px; border-radius: 12px; font-size: 12px; }

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 10px;
  margin: 27px 2px 15px;
}
.section-heading h2, .page-heading h1 {
  margin: 5px 0 0;
  font-size: 25px;
  font-weight: 950;
  letter-spacing: -.8px;
}
.section-count { color: var(--muted); font-size: 11px; }

.game-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.game-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  min-height: 175px;
  overflow: hidden;
  padding: 13px;
  border: 1px solid #ffffff16;
  border-radius: 19px;
  text-align: left;
  background: #242942;
  isolation: isolate;
}
.game-card::before {
  position: absolute;
  z-index: -1;
  inset: 0;
  content: "";
  opacity: .9;
}
.upgrade-card::before {
  background: radial-gradient(circle at 70% 30%, #ffc34d66, transparent 45%), linear-gradient(145deg, #632d24, #30213d 65%, #1d213a);
}
.dice-card::before {
  background: radial-gradient(circle at 70% 30%, #ff72b755, transparent 50%), linear-gradient(145deg, #49306e, #272b55);
}
.mines-card::before {
  background: radial-gradient(circle at 65% 25%, #48e8ff55, transparent 50%), linear-gradient(145deg, #164f6e, #282b60);
}
.cow-card::before {
  background: radial-gradient(circle at 65% 25%, #c35cff66, transparent 50%), linear-gradient(145deg, #5c317e, #242749);
}
.game-tag {
  padding: 5px 8px;
  border: 1px solid #ffffff20;
  border-radius: 9px;
  background: #14172b88;
  color: #d8d4ff;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 1.2px;
}
.game-art {
  display: grid;
  align-self: center;
  place-items: center;
  height: 90px;
  font-size: 65px;
  filter: drop-shadow(0 8px 12px #07081588);
  transition: transform .2s;
}
.game-card:active .game-art { transform: scale(1.08) rotate(-4deg); }
.game-title { font-size: 16px; font-weight: 950; letter-spacing: -.3px; }
.game-subtitle { margin-top: 4px; color: #c0c5e2; font-size: 10px; }
.card-arrow {
  position: absolute;
  right: 11px;
  bottom: 12px;
  color: #ddd7ff;
  font-size: 17px;
}
.daily-banner {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 19px;
  padding: 15px 12px;
  border: 1px solid #544c8e;
  border-radius: 18px;
  background: linear-gradient(110deg, #30255b, #222640);
}
.daily-icon { font-size: 35px; }
.daily-copy { flex: 1; min-width: 0; }
.daily-copy h3 { margin: 5px 0; font-size: 14px; }
.daily-copy p { margin: 0; color: var(--muted); font-size: 10px; }

.notice {
  margin: 18px 3px 5px;
  color: #8990b1;
  font-size: 10px;
  line-height: 1.6;
  text-align: center;
}
.notice span { color: #9b85ff; }

.page-heading { padding: 15px 2px 21px; }
.page-heading h1 { margin-top: 8px; font-size: 31px; }
.page-heading p, .muted {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}
.back-btn {
  margin: 0 0 14px;
  padding: 8px 0;
  border: 0;
  background: none;
  color: #b4aaff;
  font-weight: 800;
}
.game-panel {
  padding: 20px 15px;
  border: 1px solid #3c4164;
  border-radius: 23px;
  background: linear-gradient(160deg, #222640, #1a1e34);
  box-shadow: 0 12px 35px #090b1b35;
}
.game-panel h1 { margin: 8px 0; font-size: 29px; letter-spacing: -1px; }
.game-panel > .muted { margin-bottom: 23px; }
.dice-display {
  display: grid;
  place-items: center;
  min-height: 120px;
  margin: 16px 0 22px;
  border: 1px solid #464b76;
  border-radius: 20px;
  background: radial-gradient(circle, #51409b55, #232741);
  font-size: 76px;
}
.field-label {
  display: block;
  margin: 18px 0 9px;
  color: #a7add0;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.3px;
}
.number-options { display: grid; grid-template-columns: repeat(6, 1fr); gap: 7px; }
.number-btn {
  min-width: 0;
  aspect-ratio: 1;
  border: 1px solid #41496e;
  border-radius: 12px;
  background: #292e4a;
  font-weight: 900;
}
.number-btn.selected {
  border-color: #9a8bff;
  background: linear-gradient(140deg, #5f7aff, #7951f6);
  box-shadow: 0 0 15px #7757ff40;
}
.bet-input {
  width: 100%;
  min-height: 47px;
  padding: 0 13px;
  outline: none;
  border: 1px solid #41476b;
  border-radius: 13px;
  background: #171b30;
  color: white;
  font-weight: 800;
}
.bet-input:focus { border-color: #8976ff; }
.result-text {
  min-height: 22px;
  margin: 15px 0 0;
  color: #b8bce0;
  font-size: 12px;
  line-height: 1.6;
  text-align: center;
}
.result-text.success { color: var(--green); }
.result-text.error { color: #ff829f; }

.mines-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin: 17px 0;
}
.mines-stats > div, .chance-box {
  padding: 13px;
  border: 1px solid #3c4266;
  border-radius: 14px;
  background: #191d33;
}
.mines-stats span, .chance-box span {
  display: block;
  margin-bottom: 7px;
  color: #9ca4c7;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
}
.mines-stats strong { font-size: 21px; }
.mines-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 7px;
  margin: 15px 0;
}
.mine-cell {
  display: grid;
  place-items: center;
  min-width: 0;
  aspect-ratio: 1;
  border: 1px solid #444a76;
  border-radius: 10px;
  background: linear-gradient(145deg, #353b68, #242945);
  font-size: 22px;
  box-shadow: inset 0 1px 0 #ffffff0c;
}
.mine-cell.open-gem { border-color: #38d9dc; background: #16495b; }
.mine-cell.open-mine { border-color: #ff638e; background: #592842; }
.mine-cell:disabled { opacity: 1; }

.upgrade-stage {
  display: grid;
  grid-template-columns: 1fr 35px 1fr;
  align-items: center;
  gap: 7px;
  margin: 23px 0;
}
.upgrade-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  min-width: 0;
  padding: 18px 6px;
  border: 1px solid #474d77;
  border-radius: 16px;
  background: #282d4b;
}
.upgrade-item > span { font-size: 42px; }
.upgrade-item small { color: #aab0d0; font-size: 8px; font-weight: 900; text-align: center; }
.upgrade-item strong { font-size: 13px; }
.upgrade-item.target { border-color: #8259e7; background: linear-gradient(145deg, #40317c, #292849); }
.upgrade-arrow { color: #9f8aff; font-size: 24px; text-align: center; }
.chance-box { margin: 15px 0; }
.chance-box > div:first-child { display: flex; align-items: center; justify-content: space-between; }
.chance-box strong { color: #b6a5ff; font-size: 20px; }
.chance-track, .cow-track {
  height: 8px;
  overflow: hidden;
  border-radius: 10px;
  background: #343a5b;
}
.chance-track span, .cow-track span {
  display: block;
  width: 50%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #5d80ff, #bd6aff);
  transition: width .2s;
}
.cow-sky {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 230px;
  overflow: hidden;
  gap: 14px;
  border: 1px solid #504b91;
  border-radius: 20px;
  background: radial-gradient(ellipse at 50% 40%, #5940a9, #222445 70%);
}
.cow-stars { color: #e7dcff; letter-spacing: 6px; }
.cow-emoji { font-size: 69px; filter: drop-shadow(0 8px 15px #07071e99); }
.cow-multiplier { font-size: 35px; font-weight: 1000; color: #bba9ff; }
.cow-track { width: 75%; }
.hidden { display: none !important; }

.case-card {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  margin-bottom: 12px;
  padding: 14px 11px;
  border: 1px solid #3d4266;
  border-radius: 18px;
  background: linear-gradient(130deg, #252a47, #1c2037);
}
.daily-case { border-color: #6555b3; background: linear-gradient(120deg, #33275e, #222640); }
.case-art {
  display: grid;
  flex: 0 0 57px;
  place-items: center;
  width: 57px;
  height: 65px;
  border: 1px solid #6559a4;
  border-radius: 14px;
  background: linear-gradient(145deg, #51428a, #292947);
  font-size: 34px;
}
.case-info { flex: 1; min-width: 0; }
.case-info h2 { margin: 5px 0; font-size: 14px; }
.case-info p { margin: 4px 0; color: var(--muted); font-size: 10px; line-height: 1.5; }
.case-info strong { color: #b5a3ff; font-size: 14px; }
.case-timer { color: #6be5b0; font-size: 10px; font-weight: 800; }
.disabled-btn { background: #373b55; border-color: #4b506b; box-shadow: none; }
.placeholder-card {
  padding: 30px 20px;
  border: 1px solid #41466b;
  border-radius: 21px;
  background: radial-gradient(ellipse at top, #483582, #222640 65%);
  text-align: center;
}
.placeholder-card > span { font-size: 56px; }
.placeholder-card h2 { font-size: 20px; }
.placeholder-card p { color: var(--muted); font-size: 12px; line-height: 1.7; }

.bottom-nav {
  position: fixed;
  z-index: 20;
  left: 50%;
  bottom: calc(10px + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4px;
  width: calc(100% - 24px);
  max-width: 868px;
  padding: 7px;
  border: 1px solid #484d70;
  border-radius: 20px;
  background: #20243deF;
  box-shadow: 0 10px 35px #05061288, inset 0 1px 0 #ffffff0b;
  backdrop-filter: blur(20px);
  transform: translateX(-50%);
}
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-width: 0;
  min-height: 48px;
  padding: 5px 1px;
  border: 1px solid transparent;
  border-radius: 14px;
  background: transparent;
  color: #aab0ca;
  font-size: 10px;
  font-weight: 800;
}
.nav-item span { font-size: 17px; }
.nav-item.active {
  border-color: #8174d9;
  background: linear-gradient(120deg, #4c437e, #39325f);
  color: white;
}
.toast {
  position: fixed;
  z-index: 50;
  left: 50%;
  bottom: calc(91px + env(safe-area-inset-bottom));
  width: max-content;
  max-width: calc(100% - 35px);
  padding: 12px 17px;
  border: 1px solid #62569b;
  border-radius: 13px;
  background: #282544;
  color: white;
  font-size: 12px;
  text-align: center;
  box-shadow: 0 8px 25px #0005;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 10px);
  transition: opacity .2s, transform .2s;
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }

@media (min-width: 600px) {
  .app { padding-right: 25px; padding-left: 25px; }
  .game-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .game-card { min-height: 215px; padding: 17px; }
  .game-art { height: 115px; font-size: 78px; }
  .game-title { font-size: 19px; }
  .hero { padding: 30px; min-height: 280px; }
  .hero p { font-size: 14px; }
  .bottom-nav { bottom: 18px; }
}
